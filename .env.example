# Default: use Pi's already-authorized Sign in with ChatGPT OAuth session.
# No API key needed. Login with pi → /login → OpenAI → Sign in with ChatGPT.
YOUR_GEAR_AUTH_MODE=pi-subscription
YOUR_GEAR_PROVIDER=openai
# Optional: choose an ID from node src/cli.ts models
# YOUR_GEAR_MODEL=MODEL_ID

# Explicit billed API mode (opt-in):
# YOUR_GEAR_AUTH_MODE=api-key
# YOUR_GEAR_PROVIDER=openai
# YOUR_GEAR_MODEL=MODEL_ID
# YOUR_GEAR_API_KEY=SET_ONLY_LOCALLY_NEVER_COMMIT
