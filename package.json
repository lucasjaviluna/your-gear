{
  "name": "your-gear",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "your-gear": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke:ytk": "npm run build && node scripts/smoke-ytk.mjs",
    "pack:check": "npm run build && node scripts/smoke-package.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:classifier": "npm run build && node scripts/eval-classifier.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-mcp": "1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.19.19"
  }
}
